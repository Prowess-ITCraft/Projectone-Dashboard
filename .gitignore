.claude/skills/
.claude/settings.local.json
.impeccable/config.local.json
.impeccable/hook.cache.json

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/
*.swp

# Private context pack and customer sample documents (kept local; engineering docs live in frontend/docs)
/docs
/samples

# Local notes that hold credentials or other secrets (the seed script no longer writes any such file); never committed
*.local.txt
