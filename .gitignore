# Dependencies
node_modules/

# Build and test output
dist/
coverage/
*.tsbuildinfo

# Vite
.vite/

# Environment
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# Design tooling output (screenshots and reports from taste-skill)
.taste-skill/

# Per-developer local settings and caches
