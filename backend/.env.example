# Copy to .env for local runs outside Docker. Never commit a real .env.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://projectone:projectone@localhost:9667/projectone
CORS_ORIGINS=http://localhost:9555

# Seed script (scripts/seed_accounts.py). Set locally only; never commit a password.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# The starting password of every engineer account (at least 10 characters). Also needed by the API itself, to add
# engineers and reset them to the default. Never commit a real value.
# DEFAULT_ENGINEER_PASSWORD=
# ENGINEER_EMAIL_DOMAIN=

# Checklist evidence limits (defaults shown)
EVIDENCE_MAX_MB=10
EVIDENCE_MAX_FILES=5
